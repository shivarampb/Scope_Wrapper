{
  "schemaVersion": "1.0.0",
  "model": "RTO2064",
  "manufacturer": "Rohde & Schwarz",
  "sourceManual": "R&S RTO Digital Oscilloscope User Manual / Remote Control Commands",
  "note": "Reviewed command map. Templates match ScopeCore/src/ScopeFamilies.cpp rohdeSchwarzDialect(). %1 = channel source (CHANnel<n>).",
  "commands": {
    "identify": {
      "template": "*IDN?",
      "query": true,
      "subsystem": "Common"
    },
    "reset": {
      "template": "*RST",
      "query": false,
      "subsystem": "Common"
    },
    "clearStatus": {
      "template": "*CLS",
      "query": false,
      "subsystem": "Common"
    },
    "operationComplete": {
      "template": "*OPC?",
      "query": true,
      "subsystem": "Common"
    },
    "autoscale": {
      "template": "AUToscale",
      "query": false,
      "subsystem": "General"
    },
    "channelEnable": {
      "template": "%1:STATe %2",
      "query": false,
      "params": {
        "%2": "ON|OFF"
      },
      "subsystem": "CHANnel<n>"
    },
    "verticalScale": {
      "template": "%1:SCALe %2",
      "query": false,
      "params": {
        "%2": "volts/div"
      },
      "subsystem": "CHANnel<n>"
    },
    "verticalOffset": {
      "template": "%1:OFFSet %2",
      "query": false,
      "params": {
        "%2": "volts"
      },
      "subsystem": "CHANnel<n>"
    },
    "coupling": {
      "template": "%1:COUPling %2",
      "query": false,
      "params": {
        "%2": "DCLimit|ACLimit|GND"
      },
      "subsystem": "CHANnel<n>"
    },
    "probeAttenuation": {
      "template": "PROBe%1:SETup:ATTenuation:MANual %2",
      "query": false,
      "subsystem": "PROBe<n>"
    },
    "bandwidthLimit": {
      "template": "%1:BANDwidth %2",
      "query": false,
      "params": {
        "%2": "B20|FULL"
      },
      "subsystem": "CHANnel<n>"
    },
    "timebaseScale": {
      "template": "TIMebase:SCALe %1",
      "query": false,
      "params": {
        "%1": "s/div"
      },
      "subsystem": "TIMebase"
    },
    "timebasePosition": {
      "template": "TIMebase:POSition %1",
      "query": false,
      "params": {
        "%1": "seconds"
      },
      "subsystem": "TIMebase"
    },
    "triggerSource": {
      "template": "TRIGger:A:SOURce %1",
      "query": false,
      "subsystem": "TRIGger:A"
    },
    "triggerSlope": {
      "template": "TRIGger:A:EDGE:SLOPe %1",
      "query": false,
      "params": {
        "%1": "POSitive|NEGative|EITHer"
      },
      "subsystem": "TRIGger:A:EDGE"
    },
    "triggerLevel": {
      "template": "TRIGger:A:LEVel1 %1",
      "query": false,
      "params": {
        "%1": "volts"
      },
      "subsystem": "TRIGger:A"
    },
    "triggerMode": {
      "template": "TRIGger:A:MODE %1",
      "query": false,
      "params": {
        "%1": "AUTO|NORMal"
      },
      "subsystem": "TRIGger:A"
    },
    "acquireMode": {
      "template": "ACQuire:MODe %1",
      "query": false,
      "params": {
        "%1": "SAMPle|PDETect|AVERage|HRESolution"
      },
      "subsystem": "ACQuire"
    },
    "acquireCount": {
      "template": "ACQuire:COUNt %1",
      "query": false,
      "subsystem": "ACQuire"
    },
    "run": {
      "template": "RUN",
      "query": false,
      "subsystem": "General"
    },
    "stop": {
      "template": "STOP",
      "query": false,
      "subsystem": "General"
    },
    "single": {
      "template": "SINGle",
      "query": false,
      "subsystem": "General"
    },
    "forceTrigger": {
      "template": "TRIGger:FORCe",
      "query": false,
      "subsystem": "TRIGger"
    },
    "measureSource": {
      "template": "MEASurement1:SOURce %1",
      "query": false,
      "subsystem": "MEASurement<n>"
    },
    "measureMain": {
      "template": "MEASurement1:MAIN %1",
      "query": false,
      "params": {
        "%1": "PEAK|FREQuency|PERiod|RMS|RTIMe|FTIMe"
      },
      "subsystem": "MEASurement<n>"
    },
    "measureEnable": {
      "template": "MEASurement1:ENABle ON",
      "query": false,
      "subsystem": "MEASurement<n>"
    },
    "measureResult": {
      "template": "MEASurement1:RESult:ACTual?",
      "query": true,
      "subsystem": "MEASurement<n>"
    },
    "waveformFormat": {
      "template": "FORMat:DATA REAL,32",
      "query": false,
      "subsystem": "FORMat"
    },
    "waveformHeader": {
      "template": "%1:DATA:HEADer?",
      "query": true,
      "returns": "XStart,XStop,RecordLength,ValuesPerSample",
      "subsystem": "CHANnel<n>:DATA"
    },
    "waveformData": {
      "template": "%1:DATA?",
      "query": true,
      "returns": "IEEE 488.2 REAL,32 little-endian block (volts)",
      "subsystem": "CHANnel<n>:DATA"
    },
    "errorQueue": {
      "template": "SYSTem:ERRor:NEXT?",
      "query": true,
      "returns": "<code>,\"<message>\"",
      "subsystem": "SYSTem"
    },
    "standardEventStatus": {
      "template": "*ESR?",
      "query": true,
      "subsystem": "Common"
    },
    "statusByte": {
      "template": "*STB?",
      "query": true,
      "subsystem": "Common"
    },
    "questionableEvent": {
      "template": "STATus:QUEStionable:EVENt?",
      "query": true,
      "subsystem": "STATus"
    },
    "operationEvent": {
      "template": "STATus:OPERation:EVENt?",
      "query": true,
      "subsystem": "STATus"
    }
  }
}
