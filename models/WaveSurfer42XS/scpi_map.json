{
  "schemaVersion": "1.0.0",
  "model": "WaveSurfer 42XS",
  "manufacturer": "LeCroy",
  "sourceManual": "Teledyne LeCroy X-Stream / MAUI Oscilloscopes Remote Control Manual",
  "note": "Reviewed command map. Templates match ScopeCore/src/ScopeFamilies.cpp leCroyDialect()/CLeCroyScopeBase. %1 = channel source (C<n>). LeCroy trigger/measurement/waveform use source-prefixed commands handled in the family base.",
  "commands": {
    "identify":          { "template": "*IDN?",              "query": true,  "subsystem": "Common" },
    "reset":             { "template": "*RST",               "query": false, "subsystem": "Common" },
    "clearStatus":       { "template": "*CLS",               "query": false, "subsystem": "Common" },
    "operationComplete": { "template": "*OPC?",              "query": true,  "subsystem": "Common" },
    "autoscale":         { "template": "ASET",               "query": false, "subsystem": "Auto Setup" },
    "channelEnable":     { "template": "%1:TRAce %2",       "query": false, "params": { "%2": "ON|OFF" }, "subsystem": "C<n>:TRACE" },
    "verticalScale":     { "template": "%1:VDIV %2",        "query": false, "params": { "%2": "volts/div" }, "subsystem": "C<n>:VDIV" },
    "verticalOffset":    { "template": "%1:OFST %2",        "query": false, "params": { "%2": "volts" }, "subsystem": "C<n>:OFST" },
    "coupling":          { "template": "%1:CPL %2",         "query": false, "params": { "%2": "D1M|A1M|GND" }, "subsystem": "C<n>:CPL" },
    "probeAttenuation":  { "template": "%1:ATTN %2",        "query": false, "subsystem": "C<n>:ATTN" },
    "bandwidthLimit":    { "template": "BWL %1,%2",         "query": false, "params": { "%2": "ON|OFF" }, "subsystem": "BWL" },
    "timebaseScale":     { "template": "TDIV %1",           "query": false, "params": { "%1": "s/div" }, "subsystem": "TDIV" },
    "timebasePosition":  { "template": "TRDL %1",           "query": false, "params": { "%1": "seconds" }, "subsystem": "TRDL (trigger delay)" },
    "triggerSelect":     { "template": "TRSE EDGE,SR,%1",   "query": false, "subsystem": "TRSE" },
    "triggerSlope":      { "template": "%1:TRSL %2",        "query": false, "params": { "%2": "POS|NEG" }, "subsystem": "C<n>:TRSL" },
    "triggerLevel":      { "template": "%1:TRLV %2",        "query": false, "params": { "%2": "volts" }, "subsystem": "C<n>:TRLV" },
    "triggerMode":       { "template": "TRMD %1",           "query": false, "params": { "%1": "AUTO|NORM|SINGLE|STOP" }, "subsystem": "TRMD" },
    "run":               { "template": "TRMD AUTO",         "query": false, "subsystem": "TRMD" },
    "stop":              { "template": "STOP",              "query": false, "subsystem": "STOP" },
    "single":            { "template": "TRMD SINGLE",       "query": false, "subsystem": "TRMD" },
    "forceTrigger":      { "template": "FRTR",              "query": false, "subsystem": "FRTR" },
    "measure":           { "template": "%1:PAVA? %2",       "query": true,  "params": { "%2": "PKPK|AMPL|RMS|MAX|MIN|FREQ|PER|RISE|FALL|DUTY" }, "returns": "<PARAM>,<value> <unit>", "subsystem": "C<n>:PAVA" },
    "waveformInterval":  { "template": "%1:INSPECT? 'HORIZ_INTERVAL'", "query": true, "returns": "descriptor : <seconds>", "subsystem": "C<n>:INSPECT" },
    "waveformOffset":    { "template": "%1:INSPECT? 'HORIZ_OFFSET'",   "query": true, "returns": "descriptor : <seconds>", "subsystem": "C<n>:INSPECT" },
    "waveformData":      { "template": "%1:INSPECT? 'SIMPLE'",         "query": true, "returns": "whitespace-separated volts", "subsystem": "C<n>:INSPECT" },
    "errorStatus":       { "template": "CMR?",              "query": true,  "returns": "command-error status code", "subsystem": "CMR" },
    "standardEventStatus": { "template": "*ESR?",          "query": true,  "subsystem": "Common" },
    "statusByte":        { "template": "*STB?",             "query": true,  "subsystem": "Common" }
  }
}
